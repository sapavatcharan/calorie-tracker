generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals        Goal[]
  meals        MealEntry[]
  weights      WeightEntry[]
  chatMessages ChatMessage[]

  @@map("users")
}

model Goal {
  id             String    @id @default(cuid())
  userId         String
  dailyCalories  Int
  dailyProtein   Float?
  dailyCarbs     Float?
  dailyFat       Float?
  weightGoal     Float?
  micronutrients Json?
  startDate      DateTime  @default(now())
  endDate        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals MealEntry[]

  @@index([userId, isActive])
  @@map("goals")
}

model MealEntry {
  id             String   @id @default(cuid())
  userId         String
  goalId         String?
  foodName       String
  quantity       Float
  mealType       MealType
  calories       Float
  protein        Float?
  carbs          Float?
  fat            Float?
  micronutrients Json?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, mealType])
  @@map("meal_entries")
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  weight    Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("weight_entries")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}
